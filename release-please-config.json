{
  "release-type": "simple",
  "include-v-in-tag": false,
  "packages": {
    ".": {
      "component": "root"
    },
    "charts/flame-hub": {
      "component": "flame-hub",
      "release-type": "helm",
      "skip-github-release": true
    },
    "charts/flame-node": {
      "component": "flame-node",
      "release-type": "helm",
      "skip-github-release": true
    },
    "internal/flame-provisioner": {
      "component": "flame-provisioner",
      "release-type": "helm",
      "skip-github-release": true
    }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "global",
      "components": [
        "root",
        "flame-hub",
        "flame-node",
        "flame-provisioner"
      ]
    }
  ],
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json"
}
